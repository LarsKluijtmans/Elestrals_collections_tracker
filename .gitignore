# --- Secrets -----------------------------------------------------------------
# .env holds the M2M client secret. It must never be committed; .env.example is the
# tracked contract.
.env
.env.*
# Templates are tracked; anything holding real values is not. `.env.production` stays ignored
# even though every VITE_* in it is public by design — the rule that no .env file is ever
# committed is worth more than the one exception.
!.env.example
!.env.production.example

# --- Python ------------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node --------------------------------------------------------------------
node_modules/
dist/
*.tsbuildinfo
npm-debug.log*

# --- Editors / OS -------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Local logs ----------------------------------------------------------------
*.log
