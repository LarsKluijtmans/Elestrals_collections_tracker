# ---- App -------------------------------------------------------------------
APP_NAME=elestral-vault
ENVIRONMENT=local            # local | staging | production

# ---- Our own database --------------------------------------------------------
# The platform's MySQL instance, our own `elestrals` schema. Create it once:
#   CREATE DATABASE elestrals CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# Then: alembic upgrade head
DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/elestrals?charset=utf8mb4
DB_ECHO=false

# ---- Platform service URLs (point at your deployment) ----------------------
LOGIN_API_URL=http://127.0.0.1:8010
AUTH_API_URL=http://127.0.0.1:8050
LOGS_API_URL=http://127.0.0.1:8030
NOTIFICATIONS_API_URL=http://127.0.0.1:8020
STORAGE_API_URL=http://127.0.0.1:8070

# Must equal the Login API's TOKEN_ISSUER (the `iss` it stamps on tokens).
TOKEN_ISSUER=http://127.0.0.1:8010

# ---- M2M service account (server-side only — NEVER put these in the frontend) ----
# A client_credentials client whose RBAC role grants ALL of:
#   users:read  logs:write  usage:write
#   notifications:send  notifications:configure
#   storage:read  storage:write
# The app asserts every one of these at startup outside production and refuses to boot if
# any is missing — a missing scope otherwise dies silently inside a best-effort call.
M2M_CLIENT_ID=
M2M_CLIENT_SECRET=

# ---- Behaviour toggles -----------------------------------------------------
ENABLE_ENRICHMENT=true
ENABLE_PROJECT_LOGGING=true
ENABLE_USAGE_METERING=true
LOG_CATEGORY=elestrals
LOG_FORWARD_BUFFER_MAX=1000

# Browser origins allowed to call this API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
