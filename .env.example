# Deployment config for docker-compose. Copy to `.env` (gitignored) and fill in.
#
#   cp .env.example .env
#
# This file configures the CONTAINERS. `backend/.env` configures a locally-run backend and is
# not read by compose; `frontend/.env.production` is baked into the bundle at build time.

ENVIRONMENT=production

# --- Our own database on the platform's MySQL --------------------------------------------
# Reached as `mysql:3306` over the shared platform network — NOT the 9306 host port, which is
# how you reach it from outside Docker. Create the database and a scoped user once:
#
#   CREATE DATABASE elestrals CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'elestrals_app'@'%' IDENTIFIED BY '<password>';
#   GRANT ALL PRIVILEGES ON elestrals.* TO 'elestrals_app'@'%';
#
DATABASE_URL=mysql+pymysql://elestrals_app:<password>@mysql:3306/elestrals?charset=utf8mb4

# --- M2M service account (SERVER-SIDE ONLY — never goes in a VITE_* var) ------------------
# A client with grant type `client_credentials` and NO redirect URIs. It needs a service-account
# RBAC role granting all seven scopes, or the startup check will list what is missing:
#   users:read, logs:write, usage:write, notifications:send, notifications:configure,
#   storage:read, storage:write
M2M_CLIENT_ID=
M2M_CLIENT_SECRET=

# --- Platform endpoints -------------------------------------------------------------------
# Public URLs. The co-locate override replaces the call URLs with internal container names;
# TOKEN_ISSUER stays public because it is the `iss` the browser's token carries and we pin it.
PLATFORM_LOGIN_API_URL=https://auth.aangifteportal.nl
PLATFORM_AUTH_API_URL=https://auth-api.aangifteportal.nl
PLATFORM_LOGS_API_URL=https://logs-api.aangifteportal.nl
PLATFORM_NOTIFICATION_API_URL=https://notify-api.aangifteportal.nl
PLATFORM_STORAGE_API_URL=https://storage-api.aangifteportal.nl

# --- App ----------------------------------------------------------------------------------
CORS_ORIGINS=https://elestrals.larskluijtmans.com,http://localhost:5173,http://127.0.0.1:5173

# Operator access to /api/v1/admin/*. A caller needs this scope on their token, or their `sub`
# in OPERATOR_SUBS. Everyone else gets 403.
OPERATOR_SCOPE=elestrals:operator
OPERATOR_SUBS=

# Leave these false until the M2M scope check passes — otherwise every platform call 403s into
# a deliberately swallowed exception and the feature is silently dead.
ENABLE_ENRICHMENT=false
ENABLE_PROJECT_LOGGING=false
ENABLE_USAGE_METERING=false

# --- harvest-api: the second backend (intent 002) -------------------------------------------
# Read backend `harvest/app/harvest/gate.py` and ADR-004 before changing anything here. Several
# of these are not tuning knobs; they are the conduct posture a human decided and signed for.

# Its OWN schema, reached as its OWN MySQL user. That user must hold NO write grant on
# `elestrals` — the isolation FR-13 is built on is a database privilege, not a convention.
# See DEPLOY.md for the GRANT statements and `harvest/tests/test_grants_mysql.py` for the tests.
HARVEST_DATABASE_URL=mysql+pymysql://elestrals_harvest:CHANGEME@mysql:3306/elestrals_harvest?charset=utf8mb4
CATALOG_SCHEMA=elestrals

# Admin gate. Distinct from OPERATOR_SCOPE on purpose: re-importing the catalog and starting a
# scraper against a site that has asked us not to are different acts.
ADMIN_SCOPE=elestrals:admin
# Development only. Inert when ENVIRONMENT=production, and logged at startup if set there anyway
# — a subject allowlist is a convenience, not an authorisation system.
HARVEST_ADMIN_SUBS=

# ADR-004 gave up politeness. It did NOT give up identifiability: an anonymous bot can only be
# blocked, never asked to slow down. Empty means no scan starts.
HARVEST_CONTACT_EMAIL=

# The outbound allowlist. A source whose host is not here cannot run, however it is configured.
HARVEST_ALLOWED_HOSTS=www.ebay.com,api.ebay.com

# robots.txt is deliberately NOT consulted (ADR-004, NFR §Conduct). Recorded in configuration as
# well as in the document, because a convention broken silently reads as one nobody knew about.
HARVEST_OBEY_ROBOTS=false

# Block survival (FR-18). Sustained refusals quarantine a source rather than retrying into a
# harder block; each consecutive quarantine multiplies the previous one, up to the ceiling.
HARVEST_BLOCK_THRESHOLD=5
HARVEST_QUARANTINE_MINUTES=60
HARVEST_QUARANTINE_MAX_MINUTES=2880

# Scan shape. Lower these before raising a rate limit.
HARVEST_DEEP_MAX_QUERIES=400
HARVEST_DEEP_RESULTS_PER_QUERY=100
HARVEST_LIGHT_MAX_LISTINGS=500
HARVEST_LIGHT_RECHECK_AFTER_HOURS=12

# Below this the matcher's answer is a guess: no observation is written, and the listing is kept
# as a lead instead (FR-3).
HARVEST_MATCH_CONFIDENCE_FLOOR=0.70

# Cadences, in minutes. How often to read someone else's site is an operational decision.
HARVEST_LIGHT_EVERY_MINUTES=60
HARVEST_DEEP_EVERY_MINUTES=10080
HARVEST_ROLLUP_EVERY_MINUTES=1440

# eBay Browse (official API, asking prices). The sold connector needs no credentials — which is
# precisely why its terms matter and its risk had to be accepted by a named person.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US

# Shopify storefronts: `host:CURRENCY`, comma-separated. One shop is one source, with its own
# terms review and its own kill switch.
HARVEST_SHOPIFY_SHOPS=

# --- elestrals-api reading the rollups -----------------------------------------------------
# The ONLY thing that crosses between the services. This service holds a SELECT grant on exactly
# this one table and no write grant on anything in the harvester's schema.
HARVEST_SCHEMA=elestrals_harvest
PRICE_STALE_AFTER_HOURS=48

# --- Cloudflare tunnel (only for `--profile tunnel`) --------------------------------------
# Omit entirely if you add the hostnames to the PLATFORM's tunnel instead.
TUNNEL_TOKEN=

# --- Local debug ports (the tunnel and the web container do not use these) ----------------
API_DEBUG_PORT=9520
HARVEST_DEBUG_PORT=9540
WEB_DEBUG_PORT=9530
