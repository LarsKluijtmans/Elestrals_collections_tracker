# Template for `.env.production`, which is gitignored like every other .env.
#   cp .env.production.example .env.production   # then fill in the client id
# Baked into the production bundle by `npm run build`.
#
# EVERY value here is shipped to every visitor in plain JavaScript. There is no secret in this
# file and there must never be one: the login client is a PUBLIC client using Authorization
# Code + PKCE, which exists precisely so a browser never needs a client secret.

# The platform's login-api, on its public hostname. Must match TOKEN_ISSUER on the backend.
VITE_LOGIN_API_URL=https://auth.aangifteportal.nl

# The PUBLIC login client (grant types: authorization_code + refresh_token).
# NOT the M2M client id.
VITE_LOGIN_CLIENT_ID=

# Same-origin: nginx proxies /api/* to the backend container, so the browser makes no
# cross-origin call and needs no CORS. Set this to https://elestrals-api.larskluijtmans.com
# only if you deliberately want the split-origin arrangement instead.
VITE_BACKEND_URL=

# Must exactly match a redirect URI registered on the login client, trailing slash included.
VITE_REDIRECT_URI=https://elestrals.larskluijtmans.com/
