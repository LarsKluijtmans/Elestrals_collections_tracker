# Login API base (issues tokens; serves JWKS, branding, and the login UI config).
VITE_LOGIN_API_URL=http://127.0.0.1:8010

# Your PUBLIC login client id (PKCE — there is NO secret in the browser).
VITE_LOGIN_CLIENT_ID=

# Must EXACTLY match a redirect URI registered on the client AND an allowed origin on the
# project. For the default dev server that's http://localhost:5173/.
VITE_REDIRECT_URI=http://localhost:5173/

# This example's FastAPI backend.
VITE_BACKEND_URL=http://127.0.0.1:9000
