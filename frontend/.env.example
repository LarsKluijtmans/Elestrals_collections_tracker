# Login API base (issues tokens; serves JWKS, branding, and the login UI config).
#
# The platform publishes login-api on host port 9010 (container 8010) — the 8010 below reaches
# nothing from outside Docker. See standards/tech-stack.md for the container/host port table.
VITE_LOGIN_API_URL=http://127.0.0.1:9010

# Your PUBLIC login client id (PKCE — there is NO secret in the browser).
VITE_LOGIN_CLIENT_ID=

# Must EXACTLY match a redirect URI registered on the client AND an allowed origin on the
# project. For the default dev server that's http://localhost:5173/.
VITE_REDIRECT_URI=http://localhost:5173/

# The hosted login portal `login()` redirects to. Setting this is what makes sign-in a redirect
# to the platform's own page rather than an embedded form.
VITE_LOGIN_WEB_URL=http://127.0.0.1:9090

# elestrals-api, the collection backend. Dev runs on :9500 — :9000 is taken by
# platform-management-api. **In production leave this EMPTY**: empty means same-origin, and nginx
# proxies /api/ to the backend container.
VITE_BACKEND_URL=http://127.0.0.1:9500

# harvest-api, the second backend (intent 002) — the admin console talks to it DIRECTLY rather
# than through elestrals-api, because proxying one backend through the other would make the
# collection backend a dependency of the admin console and undo half of FR-13.
#
# Dev: the published debug port. **Production: `/harvest`** — same origin, own path prefix, which
# nginx proxies to harvest-api:9100 with the prefix stripped. Leaving this unset in a production
# build points the admin console at localhost and every request fails with no useful error.
VITE_HARVEST_URL=http://127.0.0.1:9540
